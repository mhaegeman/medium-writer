{
  "permissions": {
    "allow": [
      "Bash(medium-writer:*)",
      "Bash(mw:*)",
      "Bash(python -m pytest:*)",
      "Bash(ruff check:*)",
      "WebSearch",
      "WebFetch"
    ],
    "deny": [
      "Read(./.env)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/lint_article.py\""
          }
        ]
      }
    ]
  }
}
